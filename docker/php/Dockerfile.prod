# Copy application source into a reusable build stage.
FROM scratch AS source
COPY . /var/www/

# Build frontend assets.
FROM node:22.23.4-alpine AS frontend-build
WORKDIR /var/www

COPY --from=source /var/www/ /var/www/

ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https

ENV VITE_REVERB_APP_KEY=${VITE_REVERB_APP_KEY}
ENV VITE_REVERB_HOST=${VITE_REVERB_HOST}
ENV VITE_REVERB_PORT=${VITE_REVERB_PORT}
ENV VITE_REVERB_SCHEME=${VITE_REVERB_SCHEME}

RUN npm ci \
    && npm run build

# Base PHP-FPM image with the extensions required by Laravel.
FROM php:8.3.36-fpm AS php-base

RUN apt-get update \
    && apt-get install -y \
        git \
        unzip \
        libzip-dev \
        libpng-dev \
        libjpeg-dev \
        libfreetype6-dev \
        libwebp-dev \
        libicu-dev \
        libonig-dev \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && printf '%s\n' \
        'display_errors=Off' \
        'display_startup_errors=Off' \
        'expose_php=Off' \
        'log_errors=On' \
        'date.timezone=Asia/Tokyo' \
        'upload_max_filesize=64M' \
        'post_max_size=128M' \
        'memory_limit=256M' \
        > "$PHP_INI_DIR/conf.d/zz-app-production.ini" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www

# Install production PHP dependencies.
FROM php-base AS composer-deps

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=source /var/www/ /var/www/

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && composer install \
        --no-dev \
        --prefer-dist \
        --no-interaction \
        --no-progress \
        --optimize-autoloader

# Production PHP-FPM image.
FROM php-base AS app

COPY --from=composer-deps /var/www/ /var/www/
COPY --from=frontend-build /var/www/public/build/ /var/www/public/build/

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
        public/file \
        public/user \
        public/dummy \
        public/item \
        public/outfit \
    && chown -R www-data:www-data \
        storage \
        bootstrap/cache \
        public/file \
        public/user \
        public/dummy \
        public/item \
        public/outfit \
    && chmod -R ug+rwX \
        storage \
        bootstrap/cache \
        public/file \
        public/user \
        public/dummy \
        public/item \
        public/outfit

# Production Nginx image.
FROM nginx:1.28-alpine AS nginx

COPY --from=source /var/www/public/ /var/www/public/
COPY --from=frontend-build /var/www/public/build/ /var/www/public/build/
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p \
        /var/www/public/file \
        /var/www/public/user \
        /var/www/public/dummy \
        /var/www/public/item \
        /var/www/public/outfit
